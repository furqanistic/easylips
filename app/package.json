{
  "name": "easylips-app",
  "private": true,
  "version": "0.1.0",
  "description": "OneLingo desktop shell",
  "author": "OneLingo",
  "main": "main.cjs",
  "scripts": {
    "start": "nodemon",
    "start:once": "electron .",
    "build": "electron-builder",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.onelingo.app",
    "productName": "OneLingo",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.easylips.ai/desktop"
      }
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "files": [
      "main.cjs",
      "preload.cjs",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OneLingo"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OneLingo needs microphone access to listen for speech before translating it.",
        "NSSpeechRecognitionUsageDescription": "OneLingo may use speech recognition features while preparing live translation.",
        "NSCameraUsageDescription": "OneLingo requests media permissions through Electron for meeting compatibility."
      }
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
